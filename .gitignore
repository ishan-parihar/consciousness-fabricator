# Audio files (all collections)
meditation-repo/collections/*/audio/*
*.wav
*.mp3
*.MP3
*.flac
*.m4a
*.ogg
*.aac
*.opus
*.webm

# Generated voice reference audio
voices/ref/*.wav

# Cache and temp files
__pycache__/
*.pyc
*.pyo
.cache/
.tts-cache/
.meditate-sessions/
output/
.contexty
.memsearch
.hive

# AI agent plans
.sisyphus/#!/bin/bash
# Safe tool-state-file ignore patterns

cat >> .gitignore << 'EOF'

# Tool state files (prevent credential leaks)
.contexty/
.cortexkit/
.cursorrules
.aider*
.aider.chat.history.md
.aider.input.history
.hive/
.memsearch/
.sisyphus/
.devin/
graphify-out/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
EOF